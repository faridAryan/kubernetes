# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kubelearn?schema=public"

# NextAuth: generate a long random value, e.g. with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Set to "true" to create demo@kubelearn.dev / kubelearn-demo when seeding
SEED_DEMO_USER="false"
