generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum Difficulty {
  beginner
  intermediate
  advanced
  expert
}

enum LessonType {
  reading
  quiz
  lab
}

enum ProgressStatus {
  not_started
  in_progress
  completed
}

enum QuestionType {
  multiple_choice
  true_false
  multi_select
}

enum LabSessionStatus {
  active
  completed
  expired
}

enum BadgeCategory {
  achievement
  certification
  streak
  skill
}

enum AchievementType {
  lesson_complete
  quiz_correct
  lab_complete
  enrollment
  level_up
  badge_earned
  exam_passed
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String
  image         String?
  role          Role     @default(user)
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  labSessions    LabSession[]
  badges         UserBadge[]
  achievements   Achievement[]
  examAttempts   ExamAttempt[]
  reviewItems    ReviewItem[]
  certificates   Certificate[]

  @@index([xp])
}

model CertificationPath {
  id                  String     @id @default(cuid())
  slug                String     @unique
  name                String
  shortName           String // CKA, CKAD, CKS, KCNA
  description         String
  icon                String // emoji
  color               String // theme color
  difficulty          Difficulty
  estimatedHours      Int        @default(0)
  order               Int        @default(0)
  examQuestionCount   Int        @default(15)
  examDurationMinutes Int        @default(30)
  examPassPercent     Int        @default(66)
  createdAt           DateTime   @default(now())

  modules      Module[]
  enrollments  Enrollment[]
  examAttempts ExamAttempt[]
  certificates Certificate[]
}

model Module {
  id              String   @id @default(cuid())
  slug            String
  name            String
  description     String
  order           Int
  certificationId String
  xpReward        Int      @default(100)
  createdAt       DateTime @default(now())

  certification CertificationPath @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@unique([certificationId, slug])
}

model Lesson {
  id        String     @id @default(cuid())
  slug      String
  title     String
  content   String // markdown content
  type      LessonType
  order     Int
  moduleId  String
  xpReward  Int        @default(50)
  duration  Int        @default(10) // minutes
  createdAt DateTime   @default(now())

  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  labConfig     LabConfig?

  @@unique([moduleId, slug])
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(not_started)
  score       Int?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  lessonId      String
  question      String
  type          QuestionType
  options       Json // string[]
  correctAnswer Json // string | string[]
  explanation   String
  order         Int
  xpReward      Int          @default(10)

  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]
  reviewItems ReviewItem[]

  @@index([lessonId])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     Json
  correct    Boolean
  xpEarned   Int      @default(0)
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId, correct])
}

model LabConfig {
  id           String @id @default(cuid())
  lessonId     String @unique
  instructions String // markdown instructions
  initialState Json // simulated cluster state the lab starts from
  checks       Json // LabCheck[] evaluated against the final state
  hints        Json // string[]
  timeLimit    Int    @default(30) // minutes

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  labSessions LabSession[]
}

model LabSession {
  id          String           @id @default(cuid())
  userId      String
  labConfigId String
  status      LabSessionStatus @default(active)
  state       Json // live simulated cluster state
  commands    String[]
  startedAt   DateTime         @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  score       Int?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labConfig LabConfig @relation(fields: [labConfigId], references: [id], onDelete: Cascade)

  @@index([userId, labConfigId, status])
}

model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  certificationId String
  progress        Float     @default(0) // 0-100 percentage
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification CertificationPath @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([userId, certificationId])
}

model Badge {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String
  category    BadgeCategory
  requirement Json // BadgeRequirement
  xpReward    Int           @default(50)

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Achievement {
  id          String          @id @default(cuid())
  userId      String
  type        AchievementType
  description String
  xpEarned    Int
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ExamAttempt {
  id              String    @id @default(cuid())
  userId          String
  certificationId String
  questionIds     String[]
  answers         Json? // Record<questionId, answer>
  score           Int? // percentage
  passed          Boolean?
  startedAt       DateTime  @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification CertificationPath @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([userId, certificationId])
}

// Spaced repetition: questions answered wrong come back for review
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  intervalDays Int      @default(1)
  dueAt        DateTime

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

model Certificate {
  id              String   @id @default(cuid())
  code            String   @unique @default(cuid())
  userId          String
  certificationId String
  examScore       Int
  issuedAt        DateTime @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification CertificationPath @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([userId, certificationId])
}

// Fixed-window counter shared by all app instances
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
